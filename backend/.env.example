# Copy this file to backend/.env and fill in your real keys.
# Never commit backend/.env itself — it's already in .gitignore.

# 1. LLM API Key: Get from https://console.groq.com (free tier) or https://console.x.ai
GROK_API_KEY=your_llm_api_key_here

# 2. Shared secret between Moodle plugin and FastAPI backend (generate with secrets.token_urlsafe(32))
MOODLEBOT_API_KEY=your_shared_moodlebot_api_key_here

# 3. Salt used to anonymously hash student IDs for privacy (keep unchanged once live)
ANON_SALT=your_anon_salt_here
